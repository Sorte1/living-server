cabal-version: 2.4
name:          dashboard
version:       0.1.0.0
synopsis:      Control plane for Living Server
build-type:    Simple

executable dashboard
  main-is:          Main.hs
  hs-source-dirs:   app, src
  default-language:  Haskell2010
  ghc-options:       -Wall -threaded -rtsopts -with-rtsopts=-N

  build-depends:
    base           >= 4.14 && < 5,
    aeson          >= 2.0,
    bytestring     >= 0.10,
    text           >= 1.2,
    containers     >= 0.6,
    scotty         >= 0.20,
    http-conduit   >= 2.3,
    http-client    >= 0.7,
    http-client-tls >= 0.3,
    http-types     >= 0.12,
    network        >= 3.1,
    process        >= 1.6,
    directory      >= 1.3,
    filepath       >= 1.4,
    time           >= 1.9,
    wai            >= 3.2,
    wai-extra      >= 3.1,
    wai-middleware-static >= 0.9,
    stm            >= 2.5,
    async          >= 2.2,
    warp           >= 3.3,
    websockets     >= 0.12,
    wai-websockets >= 3.0

  other-modules:
    Dashboard.Types
    Dashboard.SwankProtocol
    Dashboard.Swank
    Dashboard.Process
    Dashboard.Claude
    Dashboard.Prompt
    Dashboard.Persistence
    Dashboard.Server
